<?xml version="1.0"?>
<ruleset name="BC MCP Abilities">
    <description>WordPress Coding Standards for the BC MCP Abilities plugin.</description>
    <file>bc-mcp-abilities.php</file>
    <file>includes</file>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg name="parallel" value="4"/>
    <rule ref="WordPress"/>
    <config name="minimum_supported_wp_version" value="6.9"/>
    <config name="text_domain" value="bc-mcp-abilities"/>
    <rule ref="WordPress.WP.Capabilities">
        <properties>
            <property name="custom_capabilities" type="array">
                <element value="edit_products"/>
                <element value="manage_woocommerce"/>
            </property>
        </properties>
    </rule>
</ruleset>
